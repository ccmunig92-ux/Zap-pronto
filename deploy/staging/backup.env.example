# Diretório absoluto, fora do checkout e em filesystem protegido/monitorado.
STAGING_BACKUP_DIR=/srv/zap-pronto/backups/staging

# Backups mais antigos são removidos somente após um novo bundle válido ser promovido.
STAGING_BACKUP_RETENTION_DAYS=14

# Devem apontar para o mesmo projeto/manifest usados pelo staging.
STAGING_COMPOSE_PROJECT=zap-pronto-staging
STAGING_COMPOSE_FILE=/srv/zap-pronto/app/deploy/staging/compose.yaml
STAGING_ENV_FILE=/srv/zap-pronto/secrets/staging/compose.env
