# Imagens publicadas e preferencialmente fixadas por digest sha256.
ZAP_API_IMAGE=ghcr.io/example/zap-pronto-api@sha256:replace-me
ZAP_WEB_IMAGE=ghcr.io/example/zap-pronto-web@sha256:replace-me
POSTGRES_IMAGE=postgres:18.3-alpine@sha256:54451ecb8ab38c24c3ec123f2fd501303a3a1856a5c66e98cecf2460d5e1e9d7
# Único listener no host; o Nginx da VPS termina HTTPS e encaminha para este loopback.
STAGING_HTTP_PORT=18080

POSTGRES_DB=zap_pronto
POSTGRES_USER=zap_pronto_owner

# Metadados OIDC, nunca client secrets.
OIDC_ISSUER=https://identity.example.com/
OIDC_AUTHORITY_ORIGIN=https://identity.example.com
OIDC_AUDIENCE=zap-pronto
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
OIDC_ORGANIZATION_CLAIM=org_id

# Caminhos absolutos fora do checkout: postgres 70:70/0400; URLs API 1000:1000/0400.
POSTGRES_PASSWORD_FILE=/srv/zap-pronto/secrets/staging/postgres-password
DATABASE_MIGRATION_URL_FILE=/srv/zap-pronto/secrets/staging/database-migration-url
DATABASE_RUNTIME_URL_FILE=/srv/zap-pronto/secrets/staging/database-runtime-url
DATABASE_WORKER_URL_FILE=/srv/zap-pronto/secrets/staging/database-worker-url

# Meta WhatsApp Cloud API. Ative o worker somente depois de validar o WABA/phone
# number ID na conexão do tenant e montar o token como secret Docker.
META_GRAPH_API_VERSION=v23.0
# Directory is provisioned outside Git with <tenantId>/<channelConnectionId>/<secret_reference> files.
META_WHATSAPP_SECRET_ROOT=/srv/zap-pronto/secrets/staging/meta
META_WHATSAPP_TIMEOUT_MS=10000
