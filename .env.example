# API (sem credenciais reais)
DATABASE_URL=postgresql://app_user:change-me@127.0.0.1:5432/zap_pronto
DATABASE_POOL_MAX=10
API_HOST=127.0.0.1
API_PORT=3000
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=zap-pronto
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# OIDC_ORGANIZATION_CLAIM=org_id

# Frontend Vite - Authorization Code com PKCE
VITE_OIDC_AUTHORITY=https://identity.example.com/
VITE_OIDC_CLIENT_ID=zap-pronto-web
VITE_OIDC_REDIRECT_URI=http://127.0.0.1:5173/
VITE_OIDC_SCOPE=openid profile email
