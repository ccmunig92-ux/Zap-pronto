FROM node:24.6.0-alpine3.22@sha256:51dbfc749ec3018c7d4bf8b9ee65299ff9a908e38918ce163b0acfcd5dd931d9 AS build

WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/api-client/package.json packages/api-client/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN pnpm install --frozen-lockfile

COPY apps/web apps/web
COPY packages/api-client packages/api-client
COPY packages/contracts packages/contracts
COPY deploy/web/validate-build.mjs deploy/web/validate-build.mjs

ARG VITE_OIDC_AUTHORITY
ARG VITE_OIDC_CLIENT_ID
ARG VITE_OIDC_REDIRECT_URI
ARG VITE_OIDC_SCOPE="openid profile email"
ARG VITE_OIDC_POST_LOGOUT_REDIRECT_URI
ARG VITE_OIDC_AUTOMATIC_SILENT_RENEW="false"
ENV VITE_OIDC_AUTHORITY=${VITE_OIDC_AUTHORITY} \
    VITE_OIDC_CLIENT_ID=${VITE_OIDC_CLIENT_ID} \
    VITE_OIDC_REDIRECT_URI=${VITE_OIDC_REDIRECT_URI} \
    VITE_OIDC_SCOPE=${VITE_OIDC_SCOPE} \
    VITE_OIDC_POST_LOGOUT_REDIRECT_URI=${VITE_OIDC_POST_LOGOUT_REDIRECT_URI} \
    VITE_OIDC_AUTOMATIC_SILENT_RENEW=${VITE_OIDC_AUTOMATIC_SILENT_RENEW}
RUN node deploy/web/validate-build.mjs \
 && pnpm --filter @zap-pronto/contracts build \
 && pnpm --filter @zap-pronto/api-client build \
 && pnpm --filter @zap-pronto/web build

FROM nginxinc/nginx-unprivileged:1.28.0-alpine3.21@sha256:c97ff0bf7cbae369953c6da1232ec14ad9f971d66360c5698db0856a4cd657a0 AS runtime

ENV API_UPSTREAM="" \
    OIDC_AUTHORITY_ORIGIN="" \
    NGINX_ENVSUBST_FILTER="^(API_UPSTREAM|OIDC_AUTHORITY_ORIGIN)$"
COPY --from=build /workspace/apps/web/dist /usr/share/nginx/html
COPY --from=build /workspace/oidc-authority-origin /etc/zap-pronto/oidc-authority-origin
COPY deploy/web/security-headers.conf /etc/nginx/security-headers.conf
COPY deploy/web/default.conf.template /etc/nginx/templates/default.conf.template
COPY --chmod=755 deploy/web/10-validate-runtime.sh /docker-entrypoint.d/10-validate-runtime.sh

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/health/web || exit 1
