{
  "name": "@zap-pronto/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:all": "pnpm --filter @zap-pronto/contracts build && pnpm build && pnpm --filter @zap-pronto/api --filter @zap-pronto/api-client build && pnpm --filter @zap-pronto/web build",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:test": "pnpm build:all && node scripts/db-test.mjs",
    "db:test:upgrade": "node scripts/db-upgrade-test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node scripts/run-built-tests.mjs dist",
    "test:all": "pnpm build:all && pnpm test && pnpm --filter @zap-pronto/contracts --filter @zap-pronto/api --filter @zap-pronto/api-client --filter @zap-pronto/web test",
    "typecheck:all": "pnpm typecheck && pnpm --filter @zap-pronto/contracts --filter @zap-pronto/api --filter @zap-pronto/api-client --filter @zap-pronto/web typecheck",
    "api:generate": "pnpm build && pnpm --filter @zap-pronto/contracts --filter @zap-pronto/api build && node scripts/generate-api-client.mjs",
    "api:check": "pnpm build && pnpm --filter @zap-pronto/contracts --filter @zap-pronto/api build && node scripts/generate-api-client.mjs --check"
    ,"release:check": "node scripts/release-check.mjs"
    ,"release:check:strict": "node scripts/release-check.mjs --strict-git --base-ref origin/main"
    ,"lovable:intake": "node scripts/lovable-intake.mjs"
    ,"test:lovable-intake": "node scripts/lovable-intake.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pg": "^8.20.4",
    "jose": "6.1.0",
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@zap-pronto/contracts": "workspace:*",
    "pg": "^8.22.0"
  },
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./dist/index.js" },
    "./database/tenant-transaction": { "types": "./src/database/tenant-transaction.ts", "default": "./dist/database/tenant-transaction.js" }
    ,"./database/current-user": { "types": "./src/database/current-user.ts", "default": "./dist/database/current-user.js" }
      ,"./domain/user-invitations": { "types": "./src/domain/user-invitations.ts", "default": "./dist/domain/user-invitations.js" }
      ,"./domain/user-administration": { "types": "./src/domain/user-administration.ts", "default": "./dist/domain/user-administration.js" }
      ,"./domain/user-invitation-acceptance": { "types": "./src/domain/user-invitation-acceptance.ts", "default": "./dist/domain/user-invitation-acceptance.js" }
      ,"./domain/invitation-acceptance-rate-limit": { "types": "./src/domain/invitation-acceptance-rate-limit.ts", "default": "./dist/domain/invitation-acceptance-rate-limit.js" }
      ,"./domain/handoffs": { "types": "./src/domain/handoffs.ts", "default": "./dist/domain/handoffs.js" }
      ,"./domain/channel-inbound": { "types": "./src/domain/channel-inbound.ts", "default": "./dist/domain/channel-inbound.js" }
      ,"./domain/meta-webhook-signature": { "types": "./src/domain/meta-webhook-signature.ts", "default": "./dist/domain/meta-webhook-signature.js" }
      ,"./domain/meta-callback": { "types": "./src/domain/meta-callback.ts", "default": "./dist/domain/meta-callback.js" }
      ,"./domain/meta-delivery-status": { "types": "./src/domain/meta-delivery-status.ts", "default": "./dist/domain/meta-delivery-status.js" }
      ,"./domain/inbound-materialization": { "types": "./src/domain/inbound-materialization.ts", "default": "./dist/domain/inbound-materialization.js" }
      ,"./domain/inbound-routing": { "types": "./src/domain/inbound-routing.ts", "default": "./dist/domain/inbound-routing.js" }
      ,"./domain/inbox-conversations": { "types": "./src/domain/inbox-conversations.ts", "default": "./dist/domain/inbox-conversations.js" }
      ,"./domain/availability": { "types": "./src/domain/availability.ts", "default": "./dist/domain/availability.js" }
      ,"./domain/team-availability": { "types": "./src/domain/team-availability.ts", "default": "./dist/domain/team-availability.js" }
        ,"./domain/sla-policy": { "types": "./src/domain/sla-policy.ts", "default": "./dist/domain/sla-policy.js" }
        ,"./domain/assignment-policy": { "types": "./src/domain/assignment-policy.ts", "default": "./dist/domain/assignment-policy.js" }
      ,"./domain/unit-operational-timezone": { "types": "./src/domain/unit-operational-timezone.ts", "default": "./dist/domain/unit-operational-timezone.js" }
      ,"./domain/shift-schedule": { "types": "./src/domain/shift-schedule.ts", "default": "./dist/domain/shift-schedule.js" }
      ,"./domain/capacity-alert": { "types": "./src/domain/capacity-alert.ts", "default": "./dist/domain/capacity-alert.js" }
      ,"./domain/channel-connections": { "types": "./src/domain/channel-connections.ts", "default": "./dist/domain/channel-connections.js" }
  },
  "types": "./src/index.ts"
}
